{
  "name": "@chatatp/studio",
  "version": "0.1.1",
  "description": "Official TypeScript/JavaScript SDK for ChatATP Studio Developer API",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/esm/react/index.js",
      "require": "./dist/cjs/react/index.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/esm/vue/index.js",
      "require": "./dist/cjs/vue/index.js"
    },
    "./angular": {
      "types": "./dist/types/angular/index.d.ts",
      "import": "./dist/esm/angular/index.js",
      "require": "./dist/cjs/angular/index.js"
    },
    "./reactnative": {
      "types": "./dist/types/reactnative/index.d.ts",
      "import": "./dist/esm/reactnative/index.js",
      "require": "./dist/cjs/reactnative/index.js"
    },
    "./web": {
      "types": "./dist/types/web/index.d.ts",
      "import": "./dist/esm/web/index.js",
      "require": "./dist/cjs/web/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "chatatp",
    "chatatp-studio",
    "ai-agents",
    "sdk",
    "typescript-sdk",
    "api-client",
    "chatbot",
    "llm",
    "agent-framework"
  ],
  "author": "Samuel Obinna Chimdi <sammyfirst6@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-14uel/chatatp_studio_javascript.git"
  },
  "bugs": {
    "url": "https://github.com/sam-14uel/chatatp_studio_javascript/issues"
  },
  "homepage": "https://studio.chat-atp.com/docs",
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@angular/core": "^21.2.18",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "angular": "^1.8.3",
    "jest": "^29.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "lit": "^3.3.3",
    "lucide": "^1.25.0",
    "marked": "^18.0.7"
  }
}
